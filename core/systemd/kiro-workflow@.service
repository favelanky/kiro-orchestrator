[Unit]
Description=Kiro Workflow (%i)
After=network.target

[Service]
Type=simple
ExecStart=%h/%i/.kiro-workflow/run.sh
WorkingDirectory=%h/%i
Restart=always
RestartSec=10
Environment=KIRO_LEAD_INTERVAL=180
Environment=KIRO_SUMMARY_INTERVAL=3600
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# Set these in an override or environment file:
# Environment=KIRO_TG_BOT_TOKEN=
# Environment=KIRO_TG_CHAT_ID=

[Install]
WantedBy=default.target
